{
  "name": "swu-scanner",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "data:fetch": "node scripts/fetch-swudb.ts .cache/swudb && node scripts/fetch-official-titles.ts .cache/official && node scripts/fetch-cardmarket.ts .cache/cardmarket",
    "data:build": "node scripts/build-data.ts .cache/swudb .cache/cardmarket .cache/official public/data",
    "assets": "node scripts/fetch-models.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.39.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
